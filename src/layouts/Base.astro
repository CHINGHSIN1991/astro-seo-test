---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { tr, useLang, switchLangPath, base, langTag } from '../i18n';
import { absoluteUrl, organizationSchema, type JsonLdNode } from '../seo';

interface Props {
  /** 頁面標題；省略則用品牌標語 */
  title?: string;
  description?: string;
  /** 頁面專屬的 JSON-LD 節點（如 Article），會與 Organization 合併成同一個 @graph */
  jsonLd?: JsonLdNode[];
}

const lang = useLang(Astro);
const $ = tr(lang);
const { title, description = $('meta.description'), jsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} — ${$('name')}` : `${$('name')} — ${$('slogan')}`;
const pathname = Astro.url.pathname;
const altPath = switchLangPath(lang, pathname);
const htmlLang = langTag(lang);
// canonical / hreflang 必須是絕對網址（見 seo.ts 的 absoluteUrl）
const canonical = absoluteUrl(Astro.site, pathname);
const altUrl = absoluteUrl(Astro.site, altPath);
// 每頁都帶 Organization；頁面另外傳入的節點（如 Article）以 @id 參照它
const schema = [organizationSchema(Astro.site, lang), ...jsonLd];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={$('name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    <link rel="alternate" hreflang={langTag(lang === 'en' ? 'zh' : 'en')} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? altUrl : canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap-index.xml`} />
    <JsonLd nodes={schema} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // 捲動淡入
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -5% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
