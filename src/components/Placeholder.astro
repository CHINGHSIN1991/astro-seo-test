---
/** 假圖元件：以灰底 + 標籤替代真實圖片或影片 */
interface Props {
  label?: string;
  aspect?: string; // 例如 "16/9"、"4/3"、"1/1"
  class?: string;
  kind?: 'image' | 'video' | 'avatar';
  dark?: boolean;
}
const { label = '假圖', aspect = '16/9', class: className = '', kind = 'image', dark = false } = Astro.props;
---

<div
  class:list={[
    'relative flex items-center justify-center overflow-hidden select-none',
    dark ? 'bg-neutral-900 text-neutral-400' : 'bg-muted text-muted-foreground',
    className,
  ]}
  style={`aspect-ratio: ${aspect};`}
  role="img"
  aria-label={label}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style={`background-image: repeating-linear-gradient(135deg, transparent 0 14px, ${dark ? 'rgba(255,255,255,.04)' : 'rgba(0,0,0,.035)'} 14px 28px);`}
  >
  </div>
  <div class="relative flex flex-col items-center gap-2 px-4 text-center">
    {kind === 'video' && (
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z" fill="currentColor" stroke="none"/></svg>
    )}
    {kind === 'image' && (
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 8"/></svg>
    )}
    {kind === 'avatar' && (
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
    )}
    <span class="text-xs font-medium tracking-wide">{label}</span>
  </div>
</div>
