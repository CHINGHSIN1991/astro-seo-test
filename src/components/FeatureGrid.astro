---
import Placeholder from './Placeholder.astro';
import { features } from '../data/site';
import { tr, useLang, type Key } from '../i18n';
const lang = useLang(Astro);
const $ = tr(lang);
---

<div class="mt-12 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  {
    features.map((f, i) => {
      const title = $(`features.${f.id}.title` as Key);
      return (
        <article class="reveal flex flex-col" style={`transition-delay:${i * 80}ms`}>
          <div class="flex aspect-[4/5] items-center justify-center overflow-hidden rounded-sm border border-border bg-muted/40 p-6">
            {f.contain ? (
              <div class="flex h-20 w-40 items-center justify-center rounded-md bg-white text-xs font-medium text-muted-foreground">{$('features.logoPlaceholder')}</div>
            ) : (
              <Placeholder label={title} aspect="auto" class="h-full w-full rounded-lg bg-white" />
            )}
          </div>
          <h3 class="mt-5 text-xl font-medium tracking-tight text-ink">{title}</h3>
          <p class="mt-2.5 leading-relaxed text-muted-foreground">{$(`features.${f.id}.description` as Key)}</p>
        </article>
      );
    })
  }
</div>
