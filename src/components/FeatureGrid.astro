---
import Placeholder from './Placeholder.astro';
import { features } from '../data/site';
---

<div class="mt-12 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  {
    features.map((f, i) => (
      <article class="reveal flex flex-col" style={`transition-delay:${i * 80}ms`}>
        <div class="flex aspect-[4/5] items-center justify-center overflow-hidden rounded-sm border border-border bg-muted/40 p-6">
          {f.contain ? (
            <div class="flex h-20 w-40 items-center justify-center rounded-md bg-white text-xs font-medium text-muted-foreground">
              Logo（假圖）
            </div>
          ) : (
            <Placeholder label={`${f.title}（假圖）`} aspect="auto" class="h-full w-full rounded-lg bg-white" />
          )}
        </div>
        <h3 class="mt-5 text-xl font-medium tracking-tight text-ink">{f.title}</h3>
        <p class="mt-2.5 leading-relaxed text-muted-foreground">{f.description}</p>
      </article>
    ))
  }
</div>
