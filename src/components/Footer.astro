---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { site } from '../data/site';
import { tr, useLang, localePath, type Key } from '../i18n';
const lang = useLang(Astro);
const $ = tr(lang);
const year = new Date().getFullYear();
const resources: { key: Key; href: string; external: boolean }[] = [
  { key: 'footer.docs', href: site.docsUrl, external: true },
  { key: 'footer.terms', href: localePath(lang, '/terms'), external: false },
  { key: 'footer.privacy', href: localePath(lang, '/privacy'), external: false },
];
---

<footer class="border-t border-border bg-white">
  <div class="container-content py-16">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-2 max-w-sm text-muted-foreground">{$('slogan')}</p>
        <div class="mt-6 flex h-12 w-32 items-center justify-center rounded border border-border bg-muted text-[11px] text-muted-foreground">{$('footer.badge')}</div>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink">{$('footer.resources')}</h3>
        <ul class="mt-4 space-y-3 text-sm">
          {resources.map((r) => (
            <li>
              <a href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener noreferrer' : undefined} class="text-muted-foreground transition-colors hover:text-ink">{$(r.key)}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink">{$('footer.contact')}</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-muted-foreground transition-colors hover:text-ink">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
              {site.email}
            </a>
          </li>
          <li>
            <a href={`tel:${site.phoneHref}`} class="flex items-center gap-2 text-muted-foreground transition-colors hover:text-ink">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              {site.phone}
            </a>
          </li>
          <li>
            <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-muted-foreground transition-colors hover:text-ink">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-border pt-8 sm:flex-row sm:items-center">
      <div class="text-sm text-muted-foreground">
        <p>© {year} {site.company} All rights reserved.</p>
        <p class="mt-1">{$('footer.note')}</p>
      </div>
      <LangSwitch class="px-0" />
    </div>
  </div>
</footer>
