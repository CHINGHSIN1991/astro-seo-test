---
import Base from '../../../layouts/Base.astro';
import NewsRow from '../../../components/NewsRow.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { getCollection, render } from 'astro:content';
import { tr, useLang, localePath, formatDate, categoryKey, pairEntries, pick, langPaths, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const pairs = pairEntries(await getCollection('updates')).sort((a, b) => b.zh.data.date.valueOf() - a.zh.data.date.valueOf());
  return langPaths().flatMap(({ params, props }) =>
    pairs.map((p) => ({
      params: { ...params, slug: p.slug },
      props: {
        lang: props.lang as Lang,
        slug: p.slug,
        entry: pick(p, props.lang),
        readNext: pairs.filter((o) => o.slug !== p.slug).slice(0, 2).map((o) => ({ slug: o.slug, entry: pick(o, props.lang) })),
      },
    })),
  );
}

const lang = useLang(Astro);
const $ = tr(lang);
const { slug, entry, readNext } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-4xl px-6 pb-24 pt-12 md:pb-32 md:pt-16">
    <a href={localePath(lang, '/updates')} class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-ink">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      {$('updates.all')}
    </a>

    <header class="mt-10 border-b border-border pb-10 md:mt-12 md:pb-14">
      <p class="text-sm font-medium text-brand">{$(categoryKey(entry.data.category))}</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-medium leading-[1.08] tracking-tightest text-ink md:text-6xl">{entry.data.title}</h1>
      <p class="mt-6 text-muted-foreground">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
        <span class="mx-2">·</span>
        {$(categoryKey(entry.data.category))}
      </p>
    </header>

    {entry.data.image && (
      <figure class="mt-10 overflow-hidden rounded-2xl bg-muted md:mt-14">
        <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} class="aspect-[4/3] w-full object-cover" />
      </figure>
    )}

    <div class="update-prose mx-auto mt-12 max-w-3xl md:mt-16">
      <Content />
    </div>
  </article>

  {readNext.length > 0 && (
    <section class="border-t border-border bg-muted/40">
      <div class="mx-auto max-w-4xl px-6 py-20 md:py-24">
        <p class="eyebrow">{$('updates.readNext')}</p>
        <div class="mt-8">
          {readNext.map((n) => (
            <NewsRow href={localePath(lang, `/updates/${n.slug}`)} category={n.entry.data.category} title={n.entry.data.title} date={n.entry.data.date} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
