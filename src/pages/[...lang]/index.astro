---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Cta from '../../components/Cta.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import { heroDemos, stats, testimonials, founder } from '../../data/site';
import { langPaths, tr, useLang, localePath, pairEntries, pick, type Key } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = useLang(Astro);
const $ = tr(lang);
const updates = pairEntries(await getCollection('updates'))
  .sort((a, b) => b.zh.data.date.valueOf() - a.zh.data.date.valueOf())
  .slice(0, 3);
const eyebrow = 'text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground';
const h2 = 'mt-4 text-3xl font-medium tracking-tightest text-ink md:text-4xl';
---

<Base>
  <!-- Hero -->
  <section id="top" class="relative overflow-hidden">
    <div class="bg-grid mask-fade-edges pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-content relative pb-16 pt-20 md:pb-24 md:pt-28">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="reveal text-balance text-5xl font-medium leading-[1.02] tracking-tightest text-ink md:text-7xl">{$('slogan')}</h1>
        <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl" style="transition-delay:60ms">{$('hero.subtitle')}</p>
        <div class="reveal mt-9 flex justify-center" style="transition-delay:120ms">
          <a href={localePath(lang, '/request-demo')} class="btn btn-primary btn-lg">
            {$('hero.bookDemo')}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- 示範影片輪播（滿版出血） -->
      <div class="reveal relative mt-16 w-screen" style="margin-left:calc(50% - 50vw);transition-delay:200ms" id="demo-carousel" aria-roledescription="carousel" aria-label={$('hero.demosLabel')}>
        <div class="relative overflow-hidden">
          <div class="relative mx-auto w-[84%] max-w-4xl md:w-[80%]">
            <div class="absolute right-full top-0 mr-3 w-full opacity-60 md:mr-6" aria-hidden="true">
              <Placeholder kind="video" dark label="" class="rounded-2xl border border-border" />
            </div>
            <div class="absolute left-full top-0 ml-3 w-full opacity-60 md:ml-6" aria-hidden="true">
              <Placeholder kind="video" dark label="" class="rounded-2xl border border-border" />
            </div>
            <div class="rounded-2xl shadow-[0_24px_80px_-24px_rgba(15,23,42,0.18)]">
              {heroDemos.map((d, i) => (
                <div class:list={['demo-slide', i !== 0 && 'hidden']} data-title={$(d.key)}>
                  <Placeholder kind="video" dark label={$(d.key)} class="rounded-2xl border border-border" />
                </div>
              ))}
            </div>
          </div>
          <button type="button" data-dir="-1" aria-label={$('hero.previousDemo')} class="absolute left-1 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white text-ink shadow-md transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 md:left-3">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" data-dir="1" aria-label={$('hero.nextDemo')} class="absolute right-1 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white text-ink shadow-md transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 md:right-3">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <div class="mt-5 text-center" aria-live="polite" aria-atomic="true">
          <h2 id="demo-title" class="text-lg font-medium text-ink">{$(heroDemos[0].key)}</h2>
        </div>
      </div>
    </div>
  </section>

  <!-- 核心功能 -->
  <section id="features" class="scroll-mt-20 bg-white">
    <div class="container-content py-24 md:py-32">
      <div class="reveal max-w-2xl">
        <h2 class="mt-4 text-4xl font-medium tracking-tightest text-ink md:text-5xl">{$('features.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{$('features.subtitle')}</p>
      </div>
      <FeatureGrid />
    </div>
  </section>

  <!-- 數據 -->
  <section class="border-y border-border bg-muted/40">
    <div class="container-content py-20 md:py-24">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class={eyebrow}>{$('stats.eyebrow')}</span>
        <h2 class={h2}>{$('stats.title')}</h2>
      </div>
      <div class="reveal mt-14 grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <div class="text-4xl font-medium tracking-tightest text-ink md:text-5xl">{s.value}</div>
            <div class="mx-auto mt-3 max-w-[12rem] text-sm leading-snug text-muted-foreground">{$(s.key)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 客戶見證 -->
  <section class="border-t border-border bg-white">
    <div class="container-content py-24 md:py-32">
      <div class="reveal max-w-2xl">
        <span class={eyebrow}>{$('testimonials.eyebrow')}</span>
        <h2 class={h2}>{$('testimonials.title')}</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {testimonials.map((t, i) => (
          <div class="reveal flex h-full flex-col rounded-2xl border border-border bg-white p-7 shadow-[0_12px_40px_rgba(15,23,42,0.05)] md:p-9" style={`transition-delay:${i * 80}ms`}>
            <div class="flex h-20 items-center border-b border-border pb-6">
              <div class="flex h-12 w-36 items-center justify-center rounded bg-muted text-xs font-medium text-muted-foreground">{$('testimonials.logoPlaceholder')}</div>
            </div>
            <blockquote class="mt-5 flex-1 text-lg leading-relaxed text-ink">{$(`testimonials.${t.id}.quote` as Key)}</blockquote>
            <footer class="mt-8 border-t border-border pt-5">
              <div class="font-medium text-ink">{$(`testimonials.${t.id}.name` as Key)}</div>
              <div class="mt-1 text-sm leading-relaxed text-muted-foreground">{$(`testimonials.${t.id}.company` as Key)}</div>
            </footer>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 合作夥伴認證 -->
  <section class="border-y border-border bg-muted/40" aria-labelledby="authorized-developer-title">
    <div class="reveal mx-auto flex max-w-(--container-content) flex-col items-center gap-8 px-6 py-12 text-center md:flex-row md:justify-center md:gap-12 md:text-left">
      <div class="flex h-20 w-52 shrink-0 items-center justify-center rounded-lg border border-border bg-white text-xs font-medium text-muted-foreground">{$('authorizedDeveloper.badge')}</div>
      <div class="md:border-l md:border-border md:pl-12">
        <h2 id="authorized-developer-title" class="text-xl font-medium tracking-tight text-ink">{$('authorizedDeveloper.title')}</h2>
        <p class="mt-2 text-muted-foreground">{$('authorizedDeveloper.description')}</p>
      </div>
    </div>
  </section>

  <!-- 願景 -->
  <section id="vision" class="scroll-mt-20 bg-white">
    <div class="container-content py-24 md:py-32">
      <div class="grid gap-14 md:grid-cols-12 md:gap-16">
        <div class="reveal md:col-span-8">
          <span class={eyebrow}>{$('team.eyebrow')}</span>
          <blockquote class="mt-6 text-2xl font-normal leading-snug tracking-tight text-ink md:text-[2rem] md:leading-[1.3]">{$('team.vision1')}</blockquote>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted-foreground">{$('team.vision2')}</p>
        </div>
        <div class="reveal md:col-span-4" style="transition-delay:100ms">
          <figure class="flex flex-col items-start">
            <div class="h-44 w-44 overflow-hidden rounded-2xl border border-border bg-muted">
              <Placeholder kind="avatar" label={$('team.photoPlaceholder')} aspect="1/1" class="h-full w-full" />
            </div>
            <figcaption class="mt-5">
              <div class="text-base font-medium text-ink">{$('team.founderName')}</div>
              <div class="text-sm text-muted-foreground">{$('team.founderTitle')}</div>
              <a href={founder.linkedin} aria-label={`${$('team.founderName')} LinkedIn`} class="mt-3 inline-flex text-muted-foreground transition-colors hover:text-brand">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              </a>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新消息 -->
  <section id="insights" class="scroll-mt-20 border-t border-border bg-white">
    <div class="container-content py-24 md:py-32">
      <div class="reveal max-w-2xl">
        <span class={eyebrow}>{$('articles.eyebrow')}</span>
        <h2 class={h2}>{$('articles.title')}</h2>
      </div>
      <div class="mt-14 grid gap-10 md:grid-cols-12">
        <div class="reveal md:col-span-8">
          {updates.map((u) => {
            const e = pick(u, lang);
            return <NewsRow href={localePath(lang, `/updates/${u.slug}`)} category={e.data.category} title={e.data.title} date={e.data.date} />;
          })}
        </div>
        <div class="reveal md:col-span-3 md:col-start-10">
          <a href={localePath(lang, '/updates')} class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-ink/20 hover:bg-muted">
            {$('updates.all')}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<script>
  const root = document.getElementById('demo-carousel');
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>('.demo-slide');
    const title = root.querySelector<HTMLElement>('#demo-title')!;
    let idx = 0;
    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('hidden', i !== idx));
      title.textContent = slides[idx].dataset.title ?? '';
    };
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => show(idx + Number(b.dataset.dir))),
    );
  }
</script>
