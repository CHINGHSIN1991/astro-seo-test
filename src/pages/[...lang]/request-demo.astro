---
import Base from '../../layouts/Base.astro';
import { site, demoFeatures, teamSizes } from '../../data/site';
import { langPaths, tr, useLang, localePath } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = useLang(Astro);
const $ = tr(lang);
const msgs = { submit: $('requestDemo.submit'), submitting: $('requestDemo.submitting') };
---

<Base title={$('requestDemo.eyebrow')} description={$('requestDemo.subtitle')}>
  <section class="relative overflow-hidden">
    <div class="bg-grid mask-fade-edges pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-content relative grid gap-12 py-16 md:grid-cols-12 md:gap-16 md:py-24">
      <!-- 左側說明 -->
      <div class="md:col-span-5">
        <span class="eyebrow">{$('requestDemo.eyebrow')}</span>
        <h1 class="mt-4 text-balance text-4xl font-medium leading-[1.08] tracking-tightest text-ink md:text-5xl">{$('requestDemo.featureTitle')}</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{$('requestDemo.subtitle')}</p>

        <ul class="mt-10 space-y-4">
          {demoFeatures.map((k) => (
            <li class="flex items-start gap-3 text-ink">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              {$(k)}
            </li>
          ))}
        </ul>

        <p class="mt-10 text-sm text-muted-foreground">
          {$('requestDemo.contactFallback')}
          <a href={`mailto:${site.email}`} class="font-medium text-brand hover:underline">{site.email}</a>
          <br />{$('requestDemo.orCall')} <a href={`tel:${site.phoneHref}`} class="font-medium text-ink hover:underline">{site.phone}</a>
        </p>
      </div>

      <!-- 右側表單 -->
      <div class="md:col-span-7">
        <div class="rounded-2xl border border-border bg-white p-6 shadow-[0_24px_80px_-32px_rgba(15,23,42,0.18)] md:p-10">
          <form id="demo-form" novalidate>
            <h2 class="text-2xl font-medium tracking-tight text-ink">{$('requestDemo.formTitle')}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{$('requestDemo.formSubtitle')}</p>

            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <div class="field">
                <label for="firstName" class="field-label">{$('requestDemo.firstName')}</label>
                <input id="firstName" name="firstName" type="text" class="field-input" required autocomplete="given-name" />
                <p class="field-error">{$('requestDemo.required')}</p>
              </div>
              <div class="field">
                <label for="lastName" class="field-label">{$('requestDemo.lastName')}</label>
                <input id="lastName" name="lastName" type="text" class="field-input" required autocomplete="family-name" />
                <p class="field-error">{$('requestDemo.required')}</p>
              </div>
              <div class="field sm:col-span-2">
                <label for="workEmail" class="field-label">{$('requestDemo.workEmail')}</label>
                <input id="workEmail" name="workEmail" type="email" class="field-input" required autocomplete="email" placeholder="name@company.com" />
                <p class="field-error">{$('requestDemo.emailInvalid')}</p>
              </div>
              <div class="field">
                <label for="company" class="field-label">{$('requestDemo.company')}</label>
                <input id="company" name="company" type="text" class="field-input" required autocomplete="organization" />
                <p class="field-error">{$('requestDemo.required')}</p>
              </div>
              <div class="field">
                <label for="companySize" class="field-label">{$('requestDemo.companySize')}</label>
                <select id="companySize" name="companySize" class="field-input" required>
                  <option value="">{$('requestDemo.selectPlaceholder')}</option>
                  {teamSizes.map((s) => <option value={s.value}>{$(s.key)}</option>)}
                </select>
                <p class="field-error">{$('requestDemo.required')}</p>
              </div>
              <div class="field">
                <label for="jobTitle" class="field-label">{$('requestDemo.jobTitle')}</label>
                <input id="jobTitle" name="jobTitle" type="text" class="field-input" required autocomplete="organization-title" />
                <p class="field-error">{$('requestDemo.required')}</p>
              </div>
              <div class="field">
                <label for="phone" class="field-label">{$('requestDemo.phone')}</label>
                <input id="phone" name="phone" type="text" class="field-input" placeholder={$('requestDemo.phonePlaceholder')} autocomplete="tel" />
              </div>
              <div class="field sm:col-span-2">
                <label for="message" class="field-label">{$('requestDemo.message')}</label>
                <textarea id="message" name="message" rows="4" class="field-input resize-y"></textarea>
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-xs text-muted-foreground">{$('requestDemo.consent')} <a href={localePath(lang, '/privacy')} class="underline hover:text-ink">{$('requestDemo.privacyPolicy')}</a></p>
              <button type="submit" class="btn btn-primary btn-lg" id="demo-submit">{$('requestDemo.submit')}</button>
            </div>
            <p id="demo-error" class="mt-4 hidden text-sm text-red-600">{$('requestDemo.error')}</p>
          </form>

          <div id="demo-success" class="hidden py-10 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-brand">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h2 class="mt-6 text-2xl font-medium tracking-tight text-ink">{$('requestDemo.successTitle')}</h2>
            <p class="mt-3 text-muted-foreground">{$('requestDemo.successBody')}</p>
            <a href={localePath(lang, '/')} class="btn btn-outline mt-8">{$('requestDemo.backHome')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ msgs, lang }}>
  const form = document.getElementById('demo-form');
  if (form) {
    const successEl = document.getElementById('demo-success');
    const errorEl = document.getElementById('demo-error');
    const submitBtn = document.getElementById('demo-submit');
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const validateField = (el) => {
      const wrap = el.closest('.field');
      if (!wrap) return true;
      let ok = true;
      if (el.required && !el.value.trim()) ok = false;
      if (ok && el.type === 'email' && el.value && !emailRe.test(el.value)) ok = false;
      wrap.classList.toggle('invalid', !ok);
      return ok;
    };

    form.querySelectorAll('.field-input').forEach((el) => {
      el.addEventListener('input', () => validateField(el));
      el.addEventListener('blur', () => validateField(el));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      const fields = Array.from(form.querySelectorAll('.field-input'));
      const allOk = fields.map(validateField).every(Boolean);
      if (!allOk) {
        form.querySelector('.field.invalid .field-input')?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = msgs.submitting;
      try {
        const payload = { ...Object.fromEntries(new FormData(form).entries()), language: lang };
        // TODO: 接上實際後端 API，例如：
        // await fetch('https://api.example.com/demo-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        await new Promise((r) => setTimeout(r, 600));
        console.info('[demo-form] 模擬送出', payload);
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        errorEl.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = msgs.submit;
      }
    });
  }
</script>
