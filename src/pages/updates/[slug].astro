---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, readNext: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

const { post, readNext } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-4xl px-6 pb-24 pt-12 md:pb-32 md:pt-16">
    <a href="/updates" class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-ink">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      所有更新
    </a>

    <header class="mt-10 border-b border-border pb-10 md:mt-12 md:pb-14">
      <p class="text-sm font-medium text-brand">{post.data.category}</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-medium leading-[1.08] tracking-tightest text-ink md:text-6xl">{post.data.title}</h1>
      <p class="mt-6 text-muted-foreground">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="mx-2">·</span>
        {post.data.category}
      </p>
    </header>

    {post.data.image && (
      <figure class="mt-10 overflow-hidden rounded-2xl bg-muted md:mt-14">
        <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} class="aspect-[4/3] w-full object-cover" />
      </figure>
    )}

    <div class="update-prose mx-auto mt-12 max-w-3xl md:mt-16">
      <Content />
    </div>
  </article>

  {readNext.length > 0 && (
    <section class="border-t border-border bg-muted/40">
      <div class="mx-auto max-w-4xl px-6 py-20 md:py-24">
        <p class="eyebrow">繼續閱讀</p>
        <div class="mt-8">
          {readNext.map((p) => (
            <NewsRow href={`/updates/${p.id}`} category={p.data.category} title={p.data.title} date={p.data.date} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
