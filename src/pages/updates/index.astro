---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="最新消息" description="Nexora AI 的產品發布、公司消息與團隊動態。">
  <div class="container-content pb-24 pt-16 md:pb-32 md:pt-24">
    <div class="grid gap-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-brand">文章</p>
        <h1 class="mt-4 text-4xl font-medium tracking-tightest text-ink md:text-5xl">最新消息</h1>
        <p class="mt-5 max-w-xs leading-relaxed text-muted-foreground">Nexora AI 的產品發布、公司消息與團隊動態。</p>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        {posts.map((p) => (
          <NewsRow href={`/updates/${p.id}`} category={p.data.category} title={p.data.title} date={p.data.date} />
        ))}
      </div>
    </div>
  </div>
</Base>
